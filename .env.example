# Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Frontend URL (for password reset links)
FRONTEND_URL=https://mosesmg255-jpg.github.io/new-lm-pages

# Database (MySQL/MariaDB)
# For local development:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=loanmanagement

# For production (FreeSQL):
# MYSQL_HOST=sql12.freesqldatabase.com
# MYSQL_PORT=3306
# MYSQL_USER=sql12835674
# MYSQL_PASSWORD=d8UKHnxaGk
# MYSQL_DATABASE=sql12835674
# DB_SSL=false

# Connection Pool (tune for production)
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_ACQUIRE=20000
DB_POOL_IDLE=10000
DB_LOGGING=false

# Security - REQUIRED for production
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN_SECRET=
SESSION_SECRET=

# CORS - Comma-separated allowed origins
CORS_ORIGINS=http://localhost:4000,http://127.0.0.1:4000

# OpenAI (optional - mock responses used if not set)
OPENAI_API_KEY=

# ── Email / SMTP Configuration ──────────────────────────────────
# Required for automatic email notifications (loan alerts, meeting notices, etc.)
# Provider options:
#   Gmail:   EMAIL_HOST=smtp.gmail.com  PORT=587  (needs Google App Password)
#   Mailtrap (sandbox/testing): EMAIL_HOST=sandbox.smtp.mailtrap.io  PORT=2525
#   Brevo:   EMAIL_HOST=smtp-relay.brevo.com  PORT=587
#
# Gmail setup: enable 2-Step Verification → myaccount.google.com/apppasswords
#              generate a 16-char App Password → paste as EMAIL_PASS
# Leave EMAIL_USER/EMAIL_PASS blank to disable emails (they log to console).
# ─────────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password
EMAIL_FROM="Loan Management System <your_email@gmail.com>"

# ── SMS Configuration (Africa's Talking) ────────────────────────
# Required for automatic SMS notifications to members
# AT_USERNAME defaults to 'sandbox' for testing. Set to your real username for prod.
# ─────────────────────────────────────────────────────────────────
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=

